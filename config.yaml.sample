# Primary configuration file for lmnop-handler.
# Environment variables with the LMNOP_HANDLER_ prefix override these values.

host: 0.0.0.0
port: 8000
cors_allow_origin_regex: '^https://[A-Za-z0-9-]+\.share\.zrok\.io$'
obsidian_bin: obsidian
vault_root: /absolute/path/to/your/vault
vault_selector: null
recent_daily_note_count: 2
upcoming_days: 7
launch_detection_timeout: 0.5
readiness_timeout: 15.0
readiness_poll_interval: 0.25
command_timeout: 15.0
